# MicroScale Safe profile: upstream Tailscale CLI + daemon, with no feature
# omission tags. Only distribution debug sections are stripped.
UPSTREAM_REPOSITORY="https://github.com/tailscale/tailscale.git"
UPSTREAM_VERSION="v1.104.5"
UPSTREAM_COMMIT="73a48057aaf5f60e4f770b398e9b7af576b01dbe"
PROFILE_TARGET_GOOS="linux"
PROFILE_TARGET_GOARCH="arm64"
PROFILE_CGO_ENABLED="0"
PROFILE_BUILD_TAGS="ts_include_cli"
BASELINE_BYTES="41733325" # 39.8 MiB, from the supplied 22.5 + 17.3 MiB baseline.
